@@ -26,10 +26,24 @@ function resolveMode({ mode, presentation } = {}) {
   return 'compact';
 }
 
+//
+// The author's name goes through app.browser.returnAddressHTML like every
+// other name in Saito, so modules that decorate names (and core's
+// username resolution) see tweet authors too.
+//
+function nameHTML(name, publicKey, app) {
+  if (publicKey && app?.browser?.returnAddressHTML) {
+    return app.browser.returnAddressHTML(publicKey, false, 'primary');
+  }
+  return `<span class="primary saito-address">${name}</span>`;
+}
+
 module.exports = ({
